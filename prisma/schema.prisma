generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
    url      = env("DATABASE_URL")
}


model User {
  id                  Int         @id @default(autoincrement())
    email               String      @unique
    password            String
    firstName           String?
    lastName            String?
    stripe_id           String? 
    created_at          DateTime    @default(now())
    updated_at          DateTime    @updatedAt

    business            Business?   
    triggers            Trigger[]
    workflows           Workflow[]
}

model Business {
  id                  Int         @id @default(autoincrement())
    business_UID        String      // The Businesses URL Path Identifier.

    user_id             Int         @unique
    user                User        @relation(fields: [user_id], references: [id])
    business_name       String
    business_type       String
    business_banner_url String?
    profile_picture_url String?
    profileDescription  String?
    contact_info        Json?       
    theme_id            Int         @default(1)
    created_at          DateTime    @default(now())
    updated_at          DateTime    @updatedAt

    business_gallery    BusinessGallery[]
    business_reviews    BusinessReviews[]
    business_faqs       BusinessFAQs[]
    business_packages   BusinessPackage[]
    business_request    Request[]
    business_bookings   BookingDetails[]
    booking_payments    BookingPayments[]

    triggers            Trigger[]
    packageItem         PackageItemOnPackage[]
    optionalAddOns      OptionalAddOns[]
}

model BusinessGallery {
    id                  Int         @id @default(autoincrement())
    business_id         Int         
    business            Business    @relation(fields: [business_id], references: [id])
    imageUrl            String      
    presignedUrl        String      @default("")
    expiresAt           DateTime    @default(now())
    created_at          DateTime    @default(now())
}

model BusinessReviews {
  id                  Int         @id @default(autoincrement())
    business_id         Int         
    business            Business    @relation(fields: [business_id], references: [id])
    from                String      
    rating              Int
    comment             String
    event_date          DateTime    @default(now())
}

model BusinessFAQs {
  id                  Int         @id @default(autoincrement())
    business_id         Int         
    business            Business    @relation(fields: [business_id], references: [id])
    question            String
    answer              String
    coreQ               Boolean   @default(false)
}

model BusinessPackage {
    id                  Int         @id @default(autoincrement())
    business_id         Int         
    business            Business    @relation(fields: [business_id], references: [id])
    title               String
    description         String?
    icon                String
    package_image_url   String
    duration_in_minutes Int?    
    price               Float?
    packageFeatures     PackageItemOnPackage[]  @relation("BusinessPackageToPackageItems")
    bookings            BookingDetails[]

    userCreatedPackage  Boolean                 @default(false)
}

model Request {
    id                  Int               @id @default(autoincrement())
    confirmationId      String            @unique
    business_id         Int         
    business            Business          @relation(fields: [business_id], references: [id])

    booking_id          Int               @unique
    booking             BookingDetails    @relation(fields: [booking_id], references: [id])

    status              RequestStatusEnum @default(PENDING)

    created_at          DateTime          @default(now())
    updated_at          DateTime          @updatedAt
}

model BookingRequestHistory {
    id                  Int               @id @default(autoincrement())
}

enum RequestStatusEnum {
    PENDING
    APPROVED
    PAID
    REJECTED
    COMPLETED
}


model BookingDetails {
  id                  Int               @id @default(autoincrement())
    confirmationId      String            @unique
    business_id         Int         
    business            Business          @relation(fields: [business_id], references: [id])
    event_date          DateTime 
    location            String
    guest_count         Int
    duration_in_minutes Int
    start_time          String
    end_time            String
    event_type          String
    personal_details    Json

    package_id          Int         
    package             BusinessPackage   @relation(fields: [package_id], references: [id])

    BookingPayments     BookingPayments[]

    request             Request?
    eventNotes          EventNotes?
    optionalAddOns      OptionalAddOns[]

    totalEventPrice     Float?
    dueBy               DateTime?

    created_at          DateTime          @default(now())
    updated_at          DateTime          @updatedAt
}

model BookingPayments {
  id                  Int               @id @default(autoincrement())
  businessId          Int
  business            Business          @relation(fields: [businessId], references: [id])

  bookingDetailsId    Int
  bookingDetails      BookingDetails    @relation(fields: [bookingDetailsId], references: [id])

  amountPayed         Float 
  payedOn             DateTime
}

model Trigger {
    id                  Int               @id @default(autoincrement())

    name                String?
    type                TriggerTypes      
    eventType           String?
    condition           Json?
    workflowId          Int
    workflow            Workflow          @relation(fields: [workflowId], references: [id])

    createdByUserId     Int?
    createdByUser       User?                @relation(fields: [createdByUserId], references: [id])

    business_id         Int
    business            Business                @relation(fields: [business_id], references: [id])
    created_at          DateTime    @default(now())
}

enum TriggerTypes {
    USER_BASED
    TIME_BASED
}

model Workflow {
  id                  Int                 @id @default(autoincrement())
    trigger             Trigger[]
    name                String
    steps               Json[]
    createdByUserId     Int?
    createdByUser       User?                @relation(fields: [createdByUserId], references: [id])
}

model Templates {
  id                  Int                 @id @default(autoincrement())
  templateString      String
  templateHtmlString  String?
}

model EventNotes {
  id                  Int                 @id @default(autoincrement())
  booking_id          Int               @unique
  booking             BookingDetails    @relation(fields: [booking_id], references: [id])

  // Encoded Notes as base 64 for compression.
  notes               String?
  rejectionNotes      String?
}

model BusinessPackageItem {
  id                  Int                 @id @default(autoincrement())
  name                String
  packages            PackageItemOnPackage[]
  
}

model PackageItemOnPackage {
  @@id([packageId, packageItemId])

  packageId         Int
  package           BusinessPackage       @relation("BusinessPackageToPackageItems", fields: [packageId], references: [id])

  packageItemId     Int
  packageItem       BusinessPackageItem  @relation(fields: [packageItemId], references: [id])

  orderIndex        Int?
  
  businessId        Int                 
  business          Business            @relation(fields: [businessId], references: [id])
}

model OptionalAddOns {
  id                  Int                 @id @default(autoincrement())
  name                String
  description         String
  price               Float

  businessId          Int
  business            Business          @relation(fields: [businessId], references: [id])

  bookingDetails      BookingDetails[]  

}
