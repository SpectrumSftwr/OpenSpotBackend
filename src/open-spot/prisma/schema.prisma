generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id                  Int         @id @default(autoincrement())

  username            String      @unique
  email               String      @unique
  password            String
  firstName           String?
  lastName            String?
  stripeId            String?      
  paymentRecieved     Boolean

  profileUrl          String?
  userDescription     String?
  siteColors          SiteColors?
  links               UserLinks[]
  offerings           Offering[]
  reviews             Reviews[]
  faqs                FAQs[]
  gallery             Gallery[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  lastLoginAt         DateTime    @default(now())
}


model SiteColors {
  id                  Int         @id @default(autoincrement())
  user                User        @relation(fields: [userId], references: [id]) 
  userId              Int         @unique // Relation scalar value used in @Relation Atrribute below
  background          String      
  foreground          String      
  accent              String      
  secondary           String      
}


model UserLinks {
  id                  Int        @id @default(autoincrement())
  user                User       @relation(fields: [userId], references:[id])
  userId              Int
  title               String?
  href                String
}

model Offering {
  id                  Int        @id @default(autoincrement())
  user                User       @relation(fields: [userId], references:[id])
  userId              Int
  title               String
  emoji               String
  description         String
}

model Reviews {
  id                  Int        @id @default(autoincrement())
  user                User       @relation(fields: [userId], references:[id])
  userId              Int
  stars               Int
  name                String
  reviewDescription   String
  Image               String 
}

model FAQs {
  id                  Int        @id @default(autoincrement())
  user                User       @relation(fields: [userId], references:[id])
  userId              Int
  question            String
  answer              String
}

model Gallery {
  id                  Int        @id @default(autoincrement())
  user                User       @relation(fields: [userId], references:[id])
  userId              Int
  imageUrl            String
}
